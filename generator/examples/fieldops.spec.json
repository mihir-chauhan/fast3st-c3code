            "appearance": "danger",
            "set": {
              "status": "Cancelled"
            },
            "when": {
              "status": [
                "Open",
                "Scheduled",
                "In Progress",
                "On Hold"
              ]
            }
          }
        ]
      },
      "form": {
        "description": "Raise a new field service work order",
