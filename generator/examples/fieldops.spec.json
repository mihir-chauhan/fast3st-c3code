  "dashboard": {
    "entity": "WorkOrder",
    "title": "Field Service Dashboard",
    "description": "Work order volume, backlog, cost, and technician workload",
    "kpis": [
      {
        "key": "openCount",
        "label": "Open work orders",
        "agg": "count",
        "where": {
          "status": [
            "Open",
            "Scheduled",
            "In Progress",
            "On Hold"
          ]
        },
        "caption": "of {totalCount} total · {criticalOpenCount} critical"
      },
      {
        "key": "overdueCount",
        "label": "Overdue",
        "agg": "count",
        "where": {
          "status": [
            "Scheduled",
            "In Progress",
            "On Hold"
          ]
        },
        "before": "scheduledDate",
        "alert": "danger",
        "caption": "{overdueShare} of open work orders"
      },
      {
        "key": "avgEstimatedHours",
        "label": "Avg estimate",
        "agg": "avg",
        "field": "estimatedHours",
        "format": "hours",
        "caption": "Planned hours per work order"
      },
      {
        "key": "completionRate",
        "label": "Completion rate",
        "agg": "ratio",
        "of": "completedCount",
        "over": "totalCount",
        "format": "percent",
        "goodAbove": 0.5,
        "caption": "{completedCount} completed · {totalCost} cost"
      },
      {
        "key": "totalCount",
        "label": "Total Work Orders",
        "agg": "count",
        "caption": "All time",
        "tile": false
      },
      {
        "key": "criticalOpenCount",
        "label": "Critical Open",
        "agg": "count",
        "where": {
          "status": [
            "Open",
            "Scheduled",
            "In Progress",
            "On Hold"
          ],
          "priority": [
            "Critical"
          ]
        },
        "alert": "warning",
        "caption": "Critical priority, still open",
        "tile": false
      },
      {
        "key": "completedCount",
        "label": "Completed",
        "agg": "count",
        "where": {
          "status": [
            "Completed"
          ]
        },
        "caption": "All time",
        "tile": false
      },
      {
        "key": "totalCost",
        "label": "Total Cost",
        "agg": "sum",
        "field": "cost",
        "format": "currency",
        "caption": "Completed work, labor and parts",
        "tile": false
      },
      {
        "key": "overdueShare",
        "label": "Overdue share",
        "agg": "ratio",
        "of": "overdueCount",
        "over": "openCount",
        "format": "percent",
        "tile": false,
        "caption": "Overdue / open"
      }
    ],
    "charts": [
      {
        "key": "monthly",
        "title": "Work orders per month",
        "subtitle": "Created vs completed",
        "kind": "monthly",
        "span": 2,
        "months": 6,
        "height": "h-80",
        "series": [
          {
            "label": "Created",
            "dateField": "createdDate",
            "appearance": "accent"
          },
          {
            "label": "Completed",
            "dateField": "completedDate",
            "appearance": "success"
          }
        ]
      },
      {
        "key": "byStatus",
        "title": "Status breakdown",
        "subtitle": "All {totalCount} work orders",
        "kind": "bars",
        "groupBy": "status"
      },
      {
        "key": "byTechnician",
        "title": "Technician workload",
        "subtitle": "Work orders assigned, top 8",
        "kind": "hbar",
        "groupBy": "technician",
        "top": 8,
        "height": "h-80",
        "span": "half",
        "skipEmpty": true
      },
      {
        "key": "costByType",
        "title": "Cost by work type",
        "kind": "bars",
        "groupBy": "workType",
        "metric": "value",
        "measure": {
          "agg": "sum",
          "field": "cost",
          "label": "Cost",
          "format": "currency"
        },
        "span": "half"
      },
      {
        "key": "byRegion",
        "title": "Work orders by region",
        "kind": "hbar",
        "groupBy": "site.region",
        "span": "half"
      },
      {
        "key": "byPriority",
        "title": "Priority mix",
        "kind": "bars",
        "groupBy": "priority",
        "span": "half"
      }
    ],
    "recent": {
      "title": "Recent overdue work orders",
      "subtitle": "{overdueCount} open past their scheduled date",
      "kpi": "overdueCount",
      "span": "half",
      "limit": 8,
      "sort": {
        "field": "scheduledDate",
        "dir": "desc"
      },
      "empty": "Nothing overdue.",
      "columns": [
        "number",
        "title",
        "site",
        {
          "since": "scheduledDate",
          "label": "Days overdue"
        }
      ],
      "after": "byTechnician"
    }
  },
  "access": {
    "type": "FieldOpsAccess",
    "roles": [
      {
        "id": "FieldOpsViewer",
        "label": "Viewer",
        "description": "Read-only access to sites, technicians, work orders and the dashboard.",
        "read": "*"
      },
      {
        "id": "FieldOpsDispatcher",
        "label": "Dispatcher",
        "description": "Viewer plus creating, editing and deleting work orders. Sites and technicians stay read-only.",
        "nested": [
          "FieldOpsViewer"
        ],
        "write": [
          "WorkOrder"
        ],
        "delete": [
          "WorkOrder"
        ]
      }
    ]
  }
}
