    {
      "name": "WorkOrder",
      "doc": "A unit of field service work performed at a {@link ServiceSite} by a {@link Technician}, tracked from creation through scheduling to completion with estimated versus actual hours and cost.",
      "plural": "Work Orders",
      "singular": "Work Order",
      "icon": "ClipboardList",
      "label": "number",
      "subtitle": "title",
      "enums": [
        {
          "name": "WorkType",
          "doc": "Kind of work a {@link WorkOrder} represents.",
          "values": [
            {
              "key": "PREVENTIVE",
              "label": "Preventive",
              "doc": "Scheduled maintenance to prevent failures.",
              "appearance": "info",
              "weight": 4
            },
            {
              "key": "CORRECTIVE",
              "label": "Corrective",
              "doc": "Repair of a reported fault.",
              "appearance": "warning",
              "weight": 5
            },
            {
              "key": "EMERGENCY",
              "label": "Emergency",
              "doc": "Urgent response to an outage or safety issue.",
              "appearance": "danger",
              "weight": 1
            },
            {
              "key": "INSTALLATION",
              "label": "Installation",
              "doc": "Installation of new equipment.",
              "appearance": "accent",
              "weight": 2
            },
            {
              "key": "INSPECTION",
              "label": "Inspection",
              "doc": "Inspection or compliance audit.",
              "appearance": "secondary",
              "weight": 2
            }
          ]
        },
        {
          "name": "Priority",
          "doc": "Urgency of a {@link WorkOrder}.",
          "values": [
            {
              "key": "LOW",
              "label": "Low",
              "doc": "Can wait for the next convenient slot.",
              "appearance": "secondary",
              "weight": 3
            },
            {
              "key": "MEDIUM",
              "label": "Medium",
              "doc": "Should be handled within the normal schedule.",
              "appearance": "info",
              "weight": 5
            },
            {
              "key": "HIGH",
              "label": "High",
              "doc": "Should be handled within a day or two.",
              "appearance": "warning",
              "weight": 3
            },
            {
              "key": "CRITICAL",
              "label": "Critical",
              "doc": "Requires immediate response.",
              "appearance": "danger",
              "weight": 1
            }
          ]
        },
        {
          "name": "Status",
          "doc": "Lifecycle status of a {@link WorkOrder}.",
          "values": [
            {
              "key": "OPEN",
              "label": "Open",
              "doc": "Raised but not yet scheduled.",
              "appearance": "info",
              "weight": 10
            },
            {
              "key": "SCHEDULED",
              "label": "Scheduled",
              "doc": "Scheduled with a date and technician.",
              "appearance": "accent",
              "weight": 12
            },
            {
              "key": "IN_PROGRESS",
              "label": "In Progress",
              "doc": "Work is underway on site.",
              "appearance": "warning",
              "weight": 9
            },
            {
              "key": "ON_HOLD",
              "label": "On Hold",
              "doc": "Paused, for example waiting on parts or customer access.",
              "appearance": "secondary",
              "weight": 5
            },
            {
              "key": "COMPLETED",
              "label": "Completed",
              "doc": "Work is finished.",
              "appearance": "success",
              "weight": 58
            },
            {
              "key": "CANCELLED",
              "label": "Cancelled",
              "doc": "Work order was cancelled and will not be performed.",
              "appearance": "primary",
              "weight": 6
            }
          ]
        }
      ],
      "fields": [
        {
          "name": "number",
          "required": true,
          "auto": "seq",
          "doc": "Human-readable work order number (e.g. `WO-10042`), unique per work order.",
          "gen": {
            "kind": "seq",
            "format": "WO-{n}",
            "start": 10001
          }
        },
        {
          "name": "workType",
          "enum": "WorkType",
          "label": "Type",
          "doc": "Kind of work being performed."
        },
        {
          "name": "title",
          "required": true,
          "doc": "Short summary of the work.",
          "gen": {
            "kind": "pickBy",
            "field": "workType",
            "values": {
              "Preventive": [
                "Quarterly rooftop unit PM",
                "Annual boiler service",
                "Chiller coil cleaning",
                "Generator load bank test",
                "Filter change and belt inspection",
                "Backflow preventer test"
              ],
              "Corrective": [
                "Walk-in cooler not holding temperature",
                "Tripped breaker on panel 3B",
                "Leaking condensate line",
                "Ice machine not producing",
                "Lighting circuit failure in warehouse",
                "Low water pressure in restrooms",
                "Rooftop unit short cycling"
              ],
              "Emergency": [
                "Total HVAC outage in server room",
                "Burst pipe in mechanical room",
                "Fire alarm panel in trouble state",
                "Freezer alarm: temperature rising"
              ],
              "Installation": [
                "Install new reach-in freezers",
                "Replace VAV controllers on floor 4",
                "Install EV charging circuits",
                "Commission new chiller"
              ],
              "Inspection": [
                "Annual fire sprinkler inspection",
                "Electrical thermography survey",
                "Refrigerant leak inspection",
                "Emergency lighting compliance check"
              ]
            }
          }
        },
        {
          "name": "description",
          "multiline": true,
          "doc": "Detailed description of the problem or requested work.",
          "gen": {
            "kind": "pickBy",
            "field": "workType",
            "values": {
              "Preventive": [
                "Routine scheduled maintenance per the service agreement. Inspect, clean and record readings.",
                "Planned maintenance visit. Replace consumables and note any parts needing follow-up."
              ],
              "Corrective": [
                "Site reported the fault this morning. Diagnose root cause and repair; quote parts if not on the truck.",
                "Intermittent fault reported by facilities. Reproduce, repair and confirm with the site contact."
              ],
              "Emergency": [
                "Site down. Respond immediately and keep the customer updated every hour until resolved."
              ],
              "Installation": [
                "Install and commission per the approved scope. Coordinate access with the site manager."
              ],
              "Inspection": [
                "Compliance inspection. Complete the checklist and upload the report to the customer portal."
              ]
            }
          }
        },
        {
          "name": "priority",
          "enum": "Priority",
          "doc": "Urgency of the work order."
        },
        {
          "name": "status",
          "enum": "Status",
          "doc": "Lifecycle status of the work order."
        },
        {
          "name": "site",
          "ref": "ServiceSite",
          "doc": "Site where the work is performed.",
          "inverse": "workOrders",
          "inverseLabel": "Work Orders"
        },
        {
          "name": "technician",
          "ref": "Technician",
          "doc": "Technician assigned to the work; unset while unassigned.",
          "inverse": "workOrders",
          "inverseLabel": "Work Orders",
          "gen": {
            "kind": "ref",
            "match": {
              "region": "site.region"
            },
            "nullRate": 0.05,
            "when": {
              "status": [
                "Scheduled",
                "In Progress",
                "On Hold",
                "Completed",
                "Cancelled"
              ]
            }
          }
        },
        {
          "name": "createdDate",
          "type": "datetime",
          "auto": "now",
          "label": "Created",
          "doc": "When the work order was raised.",
          "gen": [
            {
              "kind": "datetime",
              "fromDays": -180,
              "toDays": -4,
              "when": {
                "status": [
                  "Completed",
                  "Cancelled"
                ]
              }
            },
            {
              "kind": "datetime",
              "fromDays": -28,
              "toDays": 0
            }
          ]
        },
        {
          "name": "scheduledDate",
          "type": "datetime",
          "label": "Scheduled",
          "doc": "When the work is scheduled to be performed.",
          "gen": {
            "kind": "datetime",
            "after": "createdDate",
            "minDays": 1,
            "maxDays": 18,
            "when": {
              "status": [
                "Scheduled",
                "In Progress",
                "On Hold",
                "Completed"
              ]
            }
          }
        },
        {
          "name": "completedDate",
          "type": "datetime",
          "label": "Completed",
          "doc": "When the work was completed; set only for {@link WorkOrder.Status#COMPLETED} work orders.",
          "gen": {
            "kind": "datetime",
            "after": "scheduledDate",
            "minDays": -1,
            "maxDays": 4,
            "notAfterAsOf": true,
            "when": {
              "status": [
                "Completed"
              ]
            }
          }
        },
        {
          "name": "estimatedHours",
          "type": "double",
          "format": "hours",
          "label": "Est. Hours",
          "doc": "Planned labor hours.",
          "gen": {
            "kind": "number",
            "mean": 4.5,
            "stdDev": 2.2,
            "min": 0.5,
            "max": 16,
            "decimals": 1
          }
        },
        {
          "name": "actualHours",
          "type": "double",
          "format": "hours",
          "label": "Actual Hours",
          "doc": "Labor hours actually spent.",
          "gen": {
            "kind": "number",
            "mean": 1.08,
            "stdDev": 0.22,
            "min": 0.5,
            "max": 2.2,
            "times": "estimatedHours",
            "decimals": 1,
            "when": {
              "status": [
                "Completed"
              ]
            }
          }
        },
        {
          "name": "cost",
          "type": "double",
          "format": "currency",
          "doc": "Total cost of the work (labor and parts) in USD.",
          "gen": {
            "kind": "number",
            "mean": 145,
            "stdDev": 35,
            "min": 80,
            "max": 320,
            "times": "actualHours",
            "decimals": 2,
            "when": {
              "status": [
                "Completed"
              ]
            }
          }
        },
        {
          "name": "costPerHour",
          "label": "Cost per Hour",
          "type": "double",
          "format": "currency",
          "calc": "exists(cost) && exists(actualHours) && actualHours > 0 ? cost / actualHours : null",
          "stored": true,
          "doc": "Cost divided by actual hours; empty until the work order has both. Stored calc field, recomputed by the platform when cost or actualHours change."
        }
      ],
      "list": {
        "columns": [
          "number",
          "title",
          "site",
          "technician",
          "priority",
          "status",
          "scheduledDate",
          "cost"
        ],
        "search": [
          "number",
          "title",
          "site.name",
          "technician.name"
        ],
        "filters": [
